<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Playable with a touch screen, a controller, or both; neither is required. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <!--
      No INTERNET permission: netplay is disabled in the Android build.
      Backup: the ROM copy (rom.nes) is excluded from cloud backup and device
      transfer by the rules files; battery saves and settings may be backed up.
    -->
    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Z2rs"
        tools:targetApi="31">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.Z2rs">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The game. It runs in its own process (":game") because winit allows
          one event loop per process: quitting to the launcher finishes this
          activity and ends the process, so the next Play starts clean.
          configChanges keeps rotation, keyboards and controllers from
          recreating the native activity.
        -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.Z2rs.Game">
            <meta-data
                android:name="android.app.lib_name"
                android:value="z2rs_android" />
        </activity>
    </application>

</manifest>
