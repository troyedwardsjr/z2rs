<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher: Material 3 day/night, follows the system dark theme. -->
    <style name="Theme.Z2rs" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/z2_primary</item>
        <item name="colorOnPrimary">@color/z2_on_primary</item>
    </style>

    <!-- Game: black, no action bar, drawn edge to edge (bars hidden in code). -->
    <style name="Theme.Z2rs.Game" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/z2_primary_night</item>
        <item name="colorOnPrimary">@color/z2_on_primary_night</item>
        <item name="android:windowBackground">@color/game_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
