<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The ROM copy is excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="rom.nes" />
        <exclude domain="file" path="rom.nes.tmp" />
        <exclude domain="file" path="launch_args.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="rom.nes" />
        <exclude domain="file" path="rom.nes.tmp" />
        <exclude domain="file" path="launch_args.json" />
    </device-transfer>
</data-extraction-rules>
